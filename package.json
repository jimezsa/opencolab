{
  "name": "opencolab",
  "version": "0.1.2",
  "description": "Personal multi-agent AI research lab",
  "license": "MIT",
  "homepage": "https://github.com/jimezsa/opencolab/blob/main/CHANGELOG.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimezsa/opencolab.git"
  },
  "bugs": {
    "url": "https://github.com/jimezsa/opencolab/issues"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.5",
  "files": [
    "dist/src",
    "projects/SKILLS"
  ],
  "bin": {
    "opencolab": "dist/src/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp -R src/agent-templates dist/src/",
    "prepack": "npm run build",
    "dev": "NODE_NO_WARNINGS=1 node --enable-source-maps --experimental-strip-types src/cli.ts",
    "start": "NODE_NO_WARNINGS=1 node dist/src/cli.js",
    "test": "NODE_NO_WARNINGS=1 node --test dist/tests/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
